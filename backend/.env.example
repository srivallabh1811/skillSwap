# Copy this file to `.env` (same folder) and fill in the values.
# Only MONGODB_URI and JWT_SECRET are required; everything else is optional.

# --- Server ---
PORT=3000

# --- Database (required) ---
# Local MongoDB:   mongodb://127.0.0.1:27017/skillswap
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# --- Auth (required) ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
SESSION_SECRET=change_me_too

# --- URLs ---
# Where the React app runs (used for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used to build OAuth callback URLs)
BACKEND_URL=http://localhost:3000
# Extra comma-separated origins allowed by CORS (optional)
CORS_ORIGINS=

# --- Email login notifications (optional) ---
# Use a Gmail address + a Gmail App Password (https://myaccount.google.com/apppasswords).
# Leave empty to disable emails.
EMAIL_USER=
EMAIL_PASSWORD=

# --- Google OAuth (optional) ---
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (optional) ---
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
